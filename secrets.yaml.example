# Template for secrets.yaml. Copy it and fill in your own values:
#
#     cp secrets.yaml.example secrets.yaml
#
# secrets.yaml is gitignored, this template is not — keep real credentials
# out of it.

# SSID of the fallback access point. The device carries no hardcoded WiFi
# credentials: when it cannot reach a network it starts this AP, and you join
# it to provision the real network through the captive portal.
wifi_ap_ssid: "JetHub-Setup"

# WPA2 password for that access point, 8 to 64 characters. Set it to an empty
# string to leave the fallback AP open.
wifi_ap_password: "changeme"
